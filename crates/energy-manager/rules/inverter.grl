// Inverter data availability rules.
// Decides which derived values can be computed from available measurements.
//
// Input facts:
//   INV.ac_voltage_present  (bool)
//   INV.ac_current_present  (bool)
//
// Output facts:
//   INV.ac_power_ready      (bool, default false)

rule "INV_AC_Power_Ready" salience 100 no-loop {
    when
        INV.ac_voltage_present == true && INV.ac_current_present == true
    then
        INV.ac_power_ready = true;
}
