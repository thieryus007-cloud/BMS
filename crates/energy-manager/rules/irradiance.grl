// Irradiance sensor validation rules.
// Rejects out-of-range readings before storing in state.
//
// Input facts:
//   IR.raw   (number, W/m² from RS485 sensor)
//
// Output facts:
//   IR.valid (bool, default false — set true only when in valid range)

rule "IR_Valid_Range" salience 100 no-loop {
    when
        IR.raw >= 0.0 && IR.raw <= 2000.0
    then
        IR.valid = true;
}
