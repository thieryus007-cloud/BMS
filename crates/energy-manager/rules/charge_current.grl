// Charge current management rules.
// Decides the charge mode based on grid state and PV excess.
//
// Input facts (injected from Rust before evaluate):
//   CC.offgrid    (bool, true = off-grid / IgnoreAcIn1 == 1)
//   CC.pv_excess  (bool, pre-computed: pv_w - cons_w > pv_excess_threshold_w)
//
// Output facts (read from Rust after execute):
//   CC.mode       (string: "offgrid"|"grid_pv_excess"|"grid_no_excess")

rule "CC_Offgrid" salience 100 no-loop {
    when
        CC.offgrid == true
    then
        CC.mode = "offgrid";
}

rule "CC_Grid_PV_Excess" salience 100 no-loop {
    when
        CC.offgrid == false && CC.pv_excess == true
    then
        CC.mode = "grid_pv_excess";
}

rule "CC_Grid_No_Excess" salience 100 no-loop {
    when
        CC.offgrid == false && CC.pv_excess == false
    then
        CC.mode = "grid_no_excess";
}
