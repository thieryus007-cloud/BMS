[Unit]
Description=DalyBMS Server — Rust RS485 BMS monitor
Documentation=https://github.com/thieryus007-cloud/Daly-BMS-Rust
After=network.target mosquitto-broker.service
Wants=network.target mosquitto-broker.service
# La base metrics-store vit sur le NVMe (audit 2026-06 §7) : sans cette
# dépendance, un montage NVMe en échec/retard au boot faisait créer la base
# sur la rootfs (SD) sous /mnt/nvme → remplissage de la SD + base « fantôme »
# masquée au montage suivant. RequiresMountsFor ordonne le service après le
# mount et le fait échouer proprement (retry systemd) si le montage manque.
# (Sans entrée fstab pour /mnt/nvme, la directive est sans effet.)
RequiresMountsFor=/mnt/nvme/daly-bms
# Pas de rate-limit sur les redémarrages (clé Unit, pas Service)
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=60
User=dalybms
Group=dalybms

# Fichier de configuration TOML
Environment=DALY_CONFIG=/etc/daly-bms/config.toml

# Niveau de log (trace, debug, info, warn, error)
Environment=RUST_LOG=info

# Cap les arenas mémoire glibc à 2 (défaut = N_CPU × 8 ≈ 32 sur Pi5).
# No-op depuis qu'on utilise jemalloc (commit 75b6b84), conservé pour
# l'historique et au cas où on revient à glibc.
Environment=MALLOC_ARENA_MAX=2

# Tuning jemalloc (tikv-jemallocator utilise le préfixe `_RJEM_` pour
# éviter les conflits avec d'autres jemalloc embarqués).
# Objectif : rendre les pages au kernel rapidement pour que le RSS
# redescende après chaque pic, sans high-water mark.
#   dirty_decay_ms:1000   — pages dirty rendues après 1 s (vs 10 s par défaut)
#   muzzy_decay_ms:0      — pages muzzy rendues IMMÉDIATEMENT
#   background_thread:true — un thread dédié fait le purging en arrière-plan
#
# ⚠ narenas:2 RETIRÉ (2026-06). L'investigation §9.1 a mesuré que limiter
# à 2 arenas EMPIRE la rétention sous concurrence (le runtime tokio + le
# thread writer redb + le background_thread jemalloc se disputent 2 arenas →
# fragmentation accrue, ~7-8 MB/h « pire »). On laisse jemalloc choisir le
# nombre d'arenas (défaut = 4×N_CPU). Le diagnostic fuite-vs-rétention se
# fait désormais via le dashboard Grafana « 21 - Mémoire daly-bms »
# (process_jemalloc_allocated_bytes vs process_jemalloc_resident_bytes).
Environment=_RJEM_MALLOC_CONF=dirty_decay_ms:1000,muzzy_decay_ms:0,background_thread:true

ExecStart=/usr/local/bin/daly-bms-server

# Redémarrage automatique en cas de crash
Restart=on-failure
RestartSec=5s

# Restart quotidien (workaround fuite mémoire ~6.6 MB/h confirmée en 2026-05,
# réduite à 1.18 MB/h après tower-http 0.6 + axum 0.8).
# MISE À JOUR 2026-06 (phase D, docs/diagnostic-depannage.md §17) : root cause
# du résiduel identifiée — POST HTTP 1 Hz d'energy-manager vers
# /api/v1/solar/mppt-yield (3600 req/h × ~330 o/req de rétention par requête).
# Corrigé : télémétrie solaire migrée sur MQTT (santuario/em/solar) + réduction
# du churn d'allocations (redb_writes paresseux, AlertEngine hors broadcast,
# TraceLayer retiré). Valider via le dashboard Grafana « 21 - Mémoire daly-bms »
# (process_rss_bytes / process_jemalloc_allocated_bytes) sur 24-48 h, puis
# envisager d'allonger RuntimeMaxSec (86400 → 604800) si la pente est ~nulle.
# Coût restart : ~5 s d'interruption. MQTT retained messages reviennent,
# BMS poll RS485 reprend immédiatement. État in-memory reconstruit en <30 s.
#
# Note sur energy-manager : pas besoin d'ExecStartPost pour le restart.
# Le watchdog interne `daly_bms_server::monitor::run_watchdog_agent` sonde
# energy-manager (TCP port 8081 toutes les 15 s) et le redémarre via la
# règle polkit `50-dalybms-systemd-restart.rules` si injoignable. Ajouter
# un ExecStartPost créerait un deadlock systemd (daly-bms reste en état
# activating tant que `systemctl restart energy-manager` ne rend pas la
# main, et inversement). Cf. docs/diagnostic-depannage.md §10.
RuntimeMaxSec=86400

# Garde mémoire (audit 2026-06 §11) — à n'activer qu'AVEC la borne de points
# PromQL (§3, query_max_points) : sans elle, un dashboard 30 j légitime
# (VmPeak 367 Mo observé en 2026-05) serait tué en plein vol.
# MemoryHigh : reclaim souple (ralentit, ne tue pas). MemoryMax : filet dur —
# l'OOM killer ne vise plus que ce service au lieu de tout le Pi.
# Baseline RSS ~30-40 Mo + fuite résiduelle ~6,6 Mo/h ≈ 200 Mo avant le
# restart quotidien (RuntimeMaxSec) → marges confortables.
MemoryHigh=256M
MemoryMax=512M

# Arrêt : SIGTERM → arrêt gracieux (drain HTTP 10 s + flush metrics-store,
# audit 2026-06 §5). 20 s laissent la marge avant SIGKILL.
TimeoutStopSec=20

# Accès au port série RS485 (/dev/ttyUSB* ou /dev/ttyACM*)
SupplementaryGroups=dialout

# Répertoires gérés par systemd — créés avant le démarrage avec le bon owner.
# /var/lib/daly-bms → données runtime (l'historique time-series est dans metrics-store redb sur /mnt/nvme)
# /var/log/daly-bms → logs tournants quotidiens
StateDirectory=daly-bms
StateDirectoryMode=0750
LogsDirectory=daly-bms
LogsDirectoryMode=0750

# Sécurité minimale
NoNewPrivileges=true
PrivateTmp=true

# Logs via journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=daly-bms

[Install]
WantedBy=multi-user.target
