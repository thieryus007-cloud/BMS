    {
        "id": "a4ee00081dcaa881",
        "type": "function",
        "z": "f1e8cd3d2bfb3b52",
        "name": "Calculate Sum",
        "func": "// Récupère les dernières valeurs stockées\nlet ac = context.get('ac') || null;\nlet dc = context.get('dc') || null;\n\n// Mise à jour selon le topic\nif (msg.topic.includes('Ac/Power')) {\n    ac = msg.payload;\n    context.set('ac', ac);\n    node.log('AC updated: ' + ac);\n} else if (msg.topic.includes('Dc/Pv/Power')) {\n    dc = msg.payload;\n    context.set('dc', dc);\n    node.log('DC updated: ' + dc);\n}\n\n// Affiche le statut\nconst acOk = ac !== null && typeof ac === 'number' && !isNaN(ac);\nconst dcOk = dc !== null && typeof dc === 'number' && !isNaN(dc);\n\nnode.status({\n    fill: (acOk && dcOk) ? 'green' : 'yellow',\n    shape: 'dot',\n    text: `AC:${acOk ? ac.toFixed(1) : '---'} | DC:${dcOk ? dc.toFixed(1) : '---'}`\n});\n\n// Si les deux sont valides, calcule\nif (acOk && dcOk) {\n    const sum = ac + dc;\n    node.log('SUM: ' + ac + ' + ' + dc + ' = ' + sum);\n    \n    return {\n        payload: sum,\n        topic: 'PV/TotalPower',\n        ac: ac,\n        dc: dc,\n        timestamp: new Date().toISOString()\n    };\n}\n\nnode.log('Waiting... AC:' + acOk + ' DC:' + dcOk);\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
